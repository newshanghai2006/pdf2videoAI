# 复制本文件为 .env 并填入你自己的值（.env 不会被提交，仅本地使用）
# Copy this file to .env and fill in your own values.

# 公网部署必须保持 false。仅本地单用户需要兼容旧版客户端的设置接口时设为 true。
ENABLE_SERVER_SETTINGS=false

# ===== 邮箱验证码登录 =====
AUTH_REQUIRED=true
PUBLIC_BASE_URL=http://127.0.0.1:5000
PORT=5000
# 仅在应用只接受可信反向代理流量时设置为代理层数（常见为 1）。
TRUST_PROXY_HOPS=0
SESSION_TTL_HOURS=12
EMAIL_CODE_TTL_MINUTES=10
CAPTCHA_TTL_MINUTES=10
AUTH_CODE_COOLDOWN_SECONDS=60

# 仅用于本机调试：SMTP 未配置时把验证码显示在登录页。
# 公网部署必须设为 false，并完整配置下面的 SMTP 参数。
AUTH_PREVIEW_CODES=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Film Studio <noreply@example.com>

# ===== LLM 配置 =====
OPENAI_API_KEY=sk-your-llm-key-here

# ===== 必填：API 基地址（代理/转发地址）=====
# 标准 OpenAI: https://api.openai.com/v1
# 若你使用第三方转发（gpt-5.5 等），请填对应的 base url
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 可选：覆盖默认模型 =====
LLM_MODEL=gpt-5.5

# ===== 可选：独立图像服务 =====
# 留空则沿用上面的 LLM Key/Base URL。
# IMAGE_API_KEY=sk-your-image-key-here
# IMAGE_BASE_URL=https://image-provider.example/v1
# IMAGE_MODEL=gpt-image-1

# ===== Agnes AI 免费服务示例 =====
# Agnes 文本和图片接口均使用 OpenAI 风格的 /v1 根地址。
# OPENAI_API_KEY=your-agnes-api-key
# OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# LLM_MODEL=agnes-2.0-flash
# IMAGE_API_KEY=your-agnes-api-key
# IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
# IMAGE_MODEL=agnes-image-2.0-flash
# Agnes 视频引擎也可在界面留空 Key，以复用上面的 Agnes Key。
# AGNES_API_KEY=your-agnes-api-key
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_VIDEO_MODEL=agnes-video-v2.0
